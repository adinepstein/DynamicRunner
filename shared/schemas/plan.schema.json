{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamicrunner.app/schemas/plan.schema.json",
  "title": "Plan",
  "description": "Top-level race plan metadata. Workouts are stored separately under plans/{id}/workouts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "uid",
    "raceType",
    "raceDate",
    "methodology",
    "methodologyRationale",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "uid": { "type": "string" },
    "raceType": { "$ref": "common.schema.json#/$defs/RaceType" },
    "raceName": { "type": "string", "maxLength": 200 },
    "raceDate": { "$ref": "common.schema.json#/$defs/DateOnly" },
    "goalTimeSec": { "type": "integer", "minimum": 600, "maximum": 100000 },
    "goalPaceSecPerKm": { "$ref": "common.schema.json#/$defs/PaceSecPerKm" },
    "methodology": { "$ref": "common.schema.json#/$defs/Methodology" },
    "methodologyRationale": {
      "type": "string",
      "description": "1-paragraph explanation of why the planner chose this methodology, shown on the plan summary screen.",
      "minLength": 50,
      "maxLength": 1500
    },
    "weeklyStructure": {
      "type": "array",
      "description": "High-level macrocycle: one entry per training week, in chronological order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["isoWeek", "phase", "targetVolumeKm", "qualitySessions"],
        "properties": {
          "isoWeek": { "$ref": "common.schema.json#/$defs/IsoWeek" },
          "phase": {
            "type": "string",
            "enum": ["base", "build", "peak", "taper", "race", "recovery"]
          },
          "targetVolumeKm": { "type": "number", "minimum": 0 },
          "qualitySessions": { "type": "integer", "minimum": 0, "maximum": 5 },
          "isDeload": { "type": "boolean", "default": false }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "completed", "abandoned", "draft"]
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/DateTimeUtc" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/DateTimeUtc" },
    "lastReviewedAt": { "$ref": "common.schema.json#/$defs/DateTimeUtc" }
  }
}
